{
  "roles": [
    { "role": "line-print", "title": "Print cell" },
    { "role": "line-bond", "title": "Bond cell" },
    { "role": "line-exit", "title": "Line exit" },
    { "role": "line-operator", "title": "Line operator" },
    { "role": "line-quality", "title": "Line quality" }
  ],
  "workers": [
    {
      "taskQueue": "machine-line",
      "workflow": "machineUnitRoute",
      "config": {
        "invocable": true,
        "description": "Move a set of units along the line, one handoff per station",
        "invocationRoles": ["line-operator"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "siteId": { "type": "string" },
            "lineId": { "type": "string" },
            "routeKey": { "type": "string", "title": "Route key, unique per set of units" },
            "orderRef": { "type": "string", "title": "Order id" },
            "units": { "type": "array", "items": { "type": "object" } },
            "steps": { "type": "array", "items": { "type": "object" } },
            "handoffTimeout": { "type": "string", "title": "Handoff deadline, such as 30m" }
          },
          "required": ["siteId", "lineId", "routeKey", "orderRef", "units", "steps"]
        }
      }
    },
    {
      "taskQueue": "machine-line",
      "workflow": "changeover",
      "config": {
        "invocable": true,
        "description": "Change a machine over to a recipe and read its reply",
        "invocationRoles": ["line-operator"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "siteId": { "type": "string" },
            "lineId": { "type": "string" },
            "machineId": { "type": "string" },
            "role": { "type": "string", "title": "The machine's role" },
            "requestKey": { "type": "string", "title": "Request key, unique per command" },
            "recipe": { "type": "object", "properties": { "id": { "type": "string" }, "version": { "type": "string" } } },
            "timeout": { "type": "string" }
          },
          "required": ["siteId", "lineId", "machineId", "role", "requestKey", "recipe"]
        }
      }
    },
    {
      "taskQueue": "machine-line",
      "workflow": "machineCommand",
      "config": {
        "invocable": true,
        "description": "Ask a machine to start, stop, pause, resume or report a snapshot",
        "invocationRoles": ["line-operator"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "siteId": { "type": "string" },
            "lineId": { "type": "string" },
            "machineId": { "type": "string" },
            "role": { "type": "string" },
            "requestKey": { "type": "string" },
            "op": { "type": "string" },
            "args": { "type": "object" },
            "timeout": { "type": "string" }
          },
          "required": ["siteId", "lineId", "machineId", "role", "requestKey", "op"]
        }
      }
    }
  ]
}
